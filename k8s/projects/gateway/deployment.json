{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "projects-gateway"
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "projects-gateway"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "projects-gateway"
        },
        "annotations": {
          "config-sha256": "64b1988ba67de83ce76445093f88c522d1119e395e47baf072d026f8e5a620f1"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "nginx",
            "image": "nginx:stable-alpine",
            "ports": [
              {
                "containerPort": 80
              }
            ],
            "readinessProbe": {
              "tcpSocket": {
                "port": 80
              }
            },
            "resources": {
              "requests": {
                "cpu": "10m",
                "memory": "16Mi"
              },
              "limits": {
                "memory": "64Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "config",
                "mountPath": "/etc/nginx/conf.d",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "config",
            "configMap": {
              "name": "projects-gateway"
            }
          }
        ]
      }
    }
  }
}
